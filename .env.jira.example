# Jira 티켓 자동 생성 스크립트 설정
# 이 파일을 .env.jira 로 복사하고 실제 값으로 채워주세요.
# cp .env.jira.example .env.jira

# Atlassian 도메인 (예: https://mycompany.atlassian.net)
JIRA_BASE_URL=https://your-domain.atlassian.net

# Atlassian 계정 이메일
JIRA_EMAIL=your@email.com

# API 토큰 발급: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=your-api-token-here

# Jira 프로젝트 키 (프로젝트 설정 > 세부 정보에서 확인)
JIRA_PROJECT=MALL
